// This file is generated by generators/gen_ztt_sail.rb.
// Source: manual-main/instructions.json
// Matrix Multiply instruction families generated from the manual instruction snapshot.

// Hand-written execution semantics for this instruction category.

// Matrix layout and matrix multiply instruction implementations.

// =========================================================================
// Row-major row extraction / insertion (bit-vector level)
//
// These operate on bits(acclen) square data and extract/insert entire
// rows as vectors.  For instruction loops over rows (reductions, prefix,
// load/store), read the square once then call extract_row_rm for each row
// — avoids per-row register reads.
// =========================================================================

/* Extract row row_idx from a row-major square bit-vector.
   The row contains ame_nlen consecutive elements. */
function extract_row_rm(rm_data : bits(acclen), element_size : nat,
                        row_idx : nat) -> ame_row = {
  var row : ame_row = vector_init(zeros());
  foreach (col from 0 to (ame_nlen - 1)) {
    row[col] = extract_elem_rm(rm_data, element_size, row_idx * ame_nlen + col);
  };
  row
}

/* Insert a row into a row-major square bit-vector.
   Returns the updated bit-vector. */
function insert_row_rm(rm_data : bits(acclen), element_size : nat,
                       row_idx : nat, row : ame_row) -> bits(acclen) = {
  var result = rm_data;
  foreach (col from 0 to (ame_nlen - 1)) {
    result = insert_elem_rm(result, element_size, row_idx * ame_nlen + col, row[col]);
  };
  result
}

// =========================================================================
// M register row access (register level)
//
// Convenience wrappers that read/write a single row from/to an M register
// group.  For multi-row operations, prefer read_m_square_rm + extract_row_rm
// in a loop to avoid redundant register reads.
// =========================================================================

/* Read a single row from an M register group. */
function read_m_row_rm(dtype : bits(32), row_idx : nat,
                       base_reg : ameregidx) -> ame_row = {
  let size = ame_dtype_size(dtype);
  assert(size > 0, "read_m_row_rm: dtype uninitialized");
  let sq = read_m_square_rm(dtype, base_reg);
  extract_row_rm(sq, size, row_idx)
}

/* Write a single row to an M register group (read-modify-write). */
function write_m_row_rm(dtype : bits(32), row_idx : nat,
                        base_reg : ameregidx, row : ame_row) -> unit = {
  let size = ame_dtype_size(dtype);
  assert(size > 0, "write_m_row_rm: dtype uninitialized");
  var sq = read_m_square_rm(dtype, base_reg);
  sq = insert_row_rm(sq, size, row_idx, row);
  write_m_square_rm(dtype, base_reg, sq);
}

// =========================================================================
// M register matrix access (register level)
//
// Read an entire square from an M register group as an nlen×nlen matrix,
// or write a matrix back.  Storage-only types are rejected.
// =========================================================================

/* Read an nlen×nlen matrix from an M register group in row-major order. */
function read_m_matrix_rm(dtype : bits(32), base_reg : ameregidx) -> ame_matrix = {
  assert(not(ame_is_storage_only(dtype)), "read_m_matrix_rm: storage-only not supported");
  let sq = read_m_square_rm(dtype, base_reg);
  let size = ame_dtype_size(dtype);
  var mat : ame_matrix = vector_init(vector_init(zeros()));
  foreach (i from 0 to (ame_nlen - 1)) {
    mat[i] = extract_row_rm(sq, size, i);
  };
  mat
}

/* Write an nlen×nlen matrix to an M register group in row-major order. */
function write_m_matrix_rm(dtype : bits(32), base_reg : ameregidx,
                           mat : ame_matrix) -> unit = {
  assert(not(ame_is_storage_only(dtype)), "write_m_matrix_rm: storage-only not supported");
  let size = ame_dtype_size(dtype);
  var sq : bits(acclen) = zeros();
  foreach (i from 0 to (ame_nlen - 1)) {
    sq = insert_row_rm(sq, size, i, mat[i]);
  };
  write_m_square_rm(dtype, base_reg, sq);
}

// =========================================================================
// Acc register matrix access (register level)
//
// Acc registers hold a single nlen×nlen square.  These functions operate
// directly on the acclen-wide Acc register data, using the same row-major
// element extraction/insertion primitives.
// =========================================================================

/* Read the entire accumulator as an nlen×nlen matrix. */
function read_acc_matrix(dtype : bits(32), acc : ameaccregidx) -> ame_matrix = {
  assert(not(ame_is_storage_only(dtype)), "read_acc_matrix: storage-only not supported");
  let acc_data = ACC(acc);
  let size = ame_dtype_size(dtype);
  var mat : ame_matrix = vector_init(vector_init(zeros()));
  foreach (i from 0 to (ame_nlen - 1)) {
    mat[i] = extract_row_rm(acc_data, size, i);
  };
  mat
}

/* Write an nlen×nlen matrix to an accumulator register. */
function write_acc_matrix(dtype : bits(32), acc : ameaccregidx,
                          mat : ame_matrix) -> unit = {
  assert(not(ame_is_storage_only(dtype)), "write_acc_matrix: storage-only not supported");
  let size = ame_dtype_size(dtype);
  var acc_data : bits(acclen) = zeros();
  foreach (i from 0 to (ame_nlen - 1)) {
    acc_data = insert_row_rm(acc_data, size, i, mat[i]);
  };
  ACC(acc) = acc_data;
}

// =========================================================================
// Matrix multiply-accumulate helpers
// =========================================================================

/* Perform integer 2D matrix multiply variants.  Ordinary integer types wrap to
   the destination element size; saturating integer types clamp on writeback. */
function ame_mmul_2d_integer(ad_dtype : bits(32), ms1_dtype : bits(32),
                             ms2_dtype : bits(32), acc : ameaccregidx,
                             ms1 : ameregidx, ms2 : ameregidx,
                             accumulate : bool, subtract_product : bool,
                             transpose_a : bool, transpose_b : bool)
  -> unit = {
  let dest_size = ame_dtype_size(ad_dtype);
  let src1_size = ame_dtype_size(ms1_dtype);
  let src2_size = ame_dtype_size(ms2_dtype);

  assert(dest_size > 0, "ame_mmul_2d_integer: invalid destination dtype");
  assert(src1_size > 0, "ame_mmul_2d_integer: invalid source 1 dtype");
  assert(src2_size > 0, "ame_mmul_2d_integer: invalid source 2 dtype");
  let nsq = ame_nsq2(ms1_dtype, ms2_dtype);
  let snapshot = ame_snapshot_mregs();
  var acc_data : bits(acclen) = if accumulate then ACC(acc) else zeros();
  var saturated : bits(1) = 0b0;

  foreach (i from 0 to (ame_nlen - 1)) {
    foreach (k from 0 to (ame_nlen - 1)) {
      let dst_idx = i * ame_nlen + k;
      var sum : int = if accumulate then ame_elem_int(ad_dtype, extract_elem_rm(acc_data, dest_size, dst_idx)) else 0;
      foreach (sq from 0 to (nsq - 1)) {
        foreach (j from 0 to (ame_nlen - 1)) {
          let a_idx = if transpose_a then j * ame_nlen + i else i * ame_nlen + j;
          let b_idx = if transpose_b then k * ame_nlen + j else j * ame_nlen + k;
          let a = ame_elem_int(ms1_dtype,
            ame_read_snapshot_elem(snapshot, ms1_dtype, ms1,
                                   sq * ame_nelem + a_idx));
          let b = ame_elem_int(ms2_dtype,
            ame_read_snapshot_elem(snapshot, ms2_dtype, ms2,
                                   sq * ame_nelem + b_idx));
          let product = a * b;
          sum = if subtract_product then sum - product else sum + product;
        }
      };
      saturated = saturated | bool_to_bit(ame_int_saturates(ad_dtype, sum));
      acc_data = insert_elem_rm(acc_data, dest_size, dst_idx,
        ame_int_result_from_int(ad_dtype, sum));
    }
  };

  ACC(acc) = acc_data;
  if saturated == 0b1 then ame_set_saturated()
}

/* Perform softfloat 2D matrix multiply variants for same-size AME floating
   datatypes.  Accumulation is sequenced through the destination dtype, matching
   the elementwise AME floating helpers. */
function ame_mmul_2d_float(ad_dtype : bits(32), ms1_dtype : bits(32),
                           ms2_dtype : bits(32), acc : ameaccregidx,
                           ms1 : ameregidx, ms2 : ameregidx,
                           accumulate : bool, subtract_product : bool,
                           transpose_a : bool, transpose_b : bool,
                           rm : bits_rm)
  -> unit = {
  let dest_size = ame_dtype_size(ad_dtype);
  let src1_size = ame_dtype_size(ms1_dtype);
  let src2_size = ame_dtype_size(ms2_dtype);

  assert(dest_size > 0, "ame_mmul_2d_float: invalid destination dtype");
  assert(src1_size > 0, "ame_mmul_2d_float: invalid source 1 dtype");
  assert(src2_size > 0, "ame_mmul_2d_float: invalid source 2 dtype");
  let nsq = ame_nsq2(ms1_dtype, ms2_dtype);
  let snapshot = ame_snapshot_mregs();
  var acc_data : bits(acclen) = if accumulate then ACC(acc) else zeros();
  let fma_op = if subtract_product then AME_INT_MULNACC else AME_INT_MULACC;
  var flags : bits_fflags = zeros();

  foreach (i from 0 to (ame_nlen - 1)) {
    foreach (k from 0 to (ame_nlen - 1)) {
      let dst_idx = i * ame_nlen + k;
      var sum : bits(ame_max_dtype_size) =
        if accumulate then extract_elem_rm(acc_data, dest_size, dst_idx) else zeros();
      foreach (sq from 0 to (nsq - 1)) {
        foreach (j from 0 to (ame_nlen - 1)) {
          let a_idx = if transpose_a then j * ame_nlen + i else i * ame_nlen + j;
          let b_idx = if transpose_b then k * ame_nlen + j else j * ame_nlen + k;
          let a = ame_read_snapshot_elem(snapshot, ms1_dtype, ms1, sq * ame_nelem + a_idx);
          let b = ame_read_snapshot_elem(snapshot, ms2_dtype, ms2, sq * ame_nelem + b_idx);
          let (fflags, result) = ame_float_ternary_result(ad_dtype, fma_op, rm, sum, a, b);
          flags = flags | fflags;
          sum = result;
        };
      };
      acc_data = insert_elem_rm(acc_data, dest_size, dst_idx, sum);
    }
  };

  ACC(acc) = acc_data;
  accrue_amefflags(flags)
}

function ame_mmul_2d(ad_dtype : bits(32), ms1_dtype : bits(32),
                     ms2_dtype : bits(32), acc : ameaccregidx,
                     ms1 : ameregidx, ms2 : ameregidx,
                     accumulate : bool, subtract_product : bool,
                     transpose_a : bool, transpose_b : bool)
  -> bool = {
  let dest_nregs = ame_nregs(ame_dtype_size(ad_dtype));
  let nsq = ame_nsq2(ms1_dtype, ms2_dtype);

  if dest_nregs == 0 | ame_is_storage_only(ad_dtype) then ame_unsupported_result()
  else if ame_valid_int_elementwise_dtype(ad_dtype) & ame_valid_int_elementwise_dtype(ms1_dtype) & ame_valid_int_elementwise_dtype(ms2_dtype) then {
    if not(ame_check_formed_operand(ms1, ms1_dtype, nsq)) then false
    else if not(ame_check_formed_operand(ms2, ms2_dtype, nsq)) then false
    else {
      ame_mmul_2d_integer(ad_dtype, ms1_dtype, ms2_dtype, acc, ms1, ms2,
        accumulate, subtract_product, transpose_a, transpose_b);
      true
    }
  } else if ame_valid_softfloat_ew_dtype(ad_dtype) & ame_valid_softfloat_ew_dtype(ms1_dtype) & ame_valid_softfloat_ew_dtype(ms2_dtype) then {
    if not(ame_same_float_format3(ad_dtype, ms1_dtype, ms2_dtype)) then
      ame_unsupported_result()
    else if not(ame_check_formed_operand(ms1, ms1_dtype, nsq)) then false
    else if not(ame_check_formed_operand(ms2, ms2_dtype, nsq)) then false
    else
    match ame_fp_rounding_mode(ad_dtype) {
      None() => ame_unsupported_result(),
      Some(rm) => {
        ame_mmul_2d_float(ad_dtype, ms1_dtype, ms2_dtype, acc, ms1, ms2,
          accumulate, subtract_product, transpose_a, transpose_b, rm);
        true
      }
    }
  } else ame_unsupported_result()
}

function ame_mmulacc_2d(ad_dtype : bits(32), ms1_dtype : bits(32),
                        ms2_dtype : bits(32), acc : ameaccregidx,
                        ms1 : ameregidx, ms2 : ameregidx)
  -> bool = {
  ame_mmul_2d(ad_dtype, ms1_dtype, ms2_dtype, acc, ms1, ms2,
    true, false, false, false)
}

