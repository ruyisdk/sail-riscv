  (AME_MROWSCATADD_EW, rd, rs1, rs2) <-> perm_r3funct7_md_ms_ms_mnemonic(AME_MROWSCATADD_EW) ^ spc() ^ amereg_name_raw(rd) ^ sep() ^ amereg_name_raw(rs1) ^ sep() ^ amereg_name_raw(rs2),
