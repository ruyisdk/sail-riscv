  if not(ame_context_owned()) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(rd)) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(rs1)) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(rs2)) then return Illegal_Instruction();
  match op {
    AME_MCOLGATHER_EW => ame_retire_if(ame_gather_ew(MD(Mdregidx(rd)), MD(Mdregidx(rs1)), MD(Mdregidx(rs2)), Ameregidx(rd), Ameregidx(rs1), Ameregidx(rs2), false)),
    AME_MROWGATHER_EW => ame_retire_if(ame_gather_ew(MD(Mdregidx(rd)), MD(Mdregidx(rs1)), MD(Mdregidx(rs2)), Ameregidx(rd), Ameregidx(rs1), Ameregidx(rs2), true)),
    AME_MROWSCATADD_EW => ame_retire_if(ame_scatter_ew(MD(Mdregidx(rd)), MD(Mdregidx(rs1)), MD(Mdregidx(rs2)), Ameregidx(rd), Ameregidx(rs1), Ameregidx(rs2), AME_INT_SCATTER_ADD, true)),
    AME_MCOLSCATADD_EW => ame_retire_if(ame_scatter_ew(MD(Mdregidx(rd)), MD(Mdregidx(rs1)), MD(Mdregidx(rs2)), Ameregidx(rd), Ameregidx(rs1), Ameregidx(rs2), AME_INT_SCATTER_ADD, false)),
    AME_MROWSCATMAX_EW => ame_retire_if(ame_scatter_ew(MD(Mdregidx(rd)), MD(Mdregidx(rs1)), MD(Mdregidx(rs2)), Ameregidx(rd), Ameregidx(rs1), Ameregidx(rs2), AME_INT_SCATTER_MAX, true)),
    AME_MCOLSCATMAX_EW => ame_retire_if(ame_scatter_ew(MD(Mdregidx(rd)), MD(Mdregidx(rs1)), MD(Mdregidx(rs2)), Ameregidx(rd), Ameregidx(rs1), Ameregidx(rs2), AME_INT_SCATTER_MAX, false)),
  }
}

