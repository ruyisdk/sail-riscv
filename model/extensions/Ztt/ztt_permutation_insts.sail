  (AME_MBCAST_M_X, rd, rs1, rs2) <-> perm_r3funct7_md_xs_xs_mnemonic(AME_MBCAST_M_X) ^ spc() ^ amereg_name_raw(rd) ^ sep() ^ reg_name(encdec_reg(rs1)) ^ sep() ^ reg_name(encdec_reg(rs2)),
  (AME_MMOVE8_M_X, rd, rs1, rs2) <-> perm_r3funct7_md_xs_xs_mnemonic(AME_MMOVE8_M_X) ^ spc() ^ amereg_name_raw(rd) ^ sep() ^ reg_name(encdec_reg(rs1)) ^ sep() ^ reg_name(encdec_reg(rs2)),
  (AME_MMOVE16_M_X, rd, rs1, rs2) <-> perm_r3funct7_md_xs_xs_mnemonic(AME_MMOVE16_M_X) ^ spc() ^ amereg_name_raw(rd) ^ sep() ^ reg_name(encdec_reg(rs1)) ^ sep() ^ reg_name(encdec_reg(rs2)),
  (AME_MMOVE32_M_X, rd, rs1, rs2) <-> perm_r3funct7_md_xs_xs_mnemonic(AME_MMOVE32_M_X) ^ spc() ^ amereg_name_raw(rd) ^ sep() ^ reg_name(encdec_reg(rs1)) ^ sep() ^ reg_name(encdec_reg(rs2)),
  (AME_MMOVE64_M_X, rd, rs1, rs2) <-> perm_r3funct7_md_xs_xs_mnemonic(AME_MMOVE64_M_X) ^ spc() ^ amereg_name_raw(rd) ^ sep() ^ reg_name(encdec_reg(rs1)) ^ sep() ^ reg_name(encdec_reg(rs2)),
}

union clause instruction = PERM_R3_MD_XS_XS_TYPE : (perm_r3funct7_md_xs_xs, bits(5), bits(5), bits(5))

mapping clause encdec = PERM_R3_MD_XS_XS_TYPE(op, rd, rs1, rs2)
  <-> encdec_perm_r3funct7_md_xs_xs(op) @ rs2 : bits(5) @ rs1 : bits(5) @ 0b000 @ rd : bits(5) @ 0b0101011
  when currentlyEnabled(Ext_Ztt)

mapping clause assembly = PERM_R3_MD_XS_XS_TYPE(op, rd, rs1, rs2)
  <-> perm_r3funct7_md_xs_xs_assembly(op, rd, rs1, rs2)

function clause execute PERM_R3_MD_XS_XS_TYPE(op, rd, rs1, rs2) = {
  if not(ame_context_owned()) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(rd)) then return Illegal_Instruction();
  match op {
    AME_MBCAST_M_X => {
      let md_dtype : bits(32) = MD(Mdregidx(rd));
      let ms1_dtype : bits(32) = X(Regidx(trunc(rs2)))[31..0];
      if not(ame_datatype_supported(md_dtype) & ame_datatype_supported(ms1_dtype)) | md_dtype != ms1_dtype then {
        ame_set_unsupported();
        RETIRE_SUCCESS
      } else ame_retire_if(ame_broadcast_typed_x(md_dtype, ms1_dtype, Ameregidx(rd), X(Regidx(trunc(rs1)))))
    },
    AME_MMOVE8_M_X => ame_retire_if(ame_debug_mmove_write(Ameregidx(rd), X(Regidx(trunc(rs2))), to_bits_unsafe(64, unsigned(X(Regidx(trunc(rs1))))), 8)),
    AME_MMOVE16_M_X => ame_retire_if(ame_debug_mmove_write(Ameregidx(rd), X(Regidx(trunc(rs2))), to_bits_unsafe(64, unsigned(X(Regidx(trunc(rs1))))), 16)),
    AME_MMOVE32_M_X => ame_retire_if(ame_debug_mmove_write(Ameregidx(rd), X(Regidx(trunc(rs2))), to_bits_unsafe(64, unsigned(X(Regidx(trunc(rs1))))), 32)),
    AME_MMOVE64_M_X => {
      if xlen < 64 then return Illegal_Instruction();
      ame_retire_if(ame_debug_mmove_write(Ameregidx(rd), X(Regidx(trunc(rs2))), to_bits_unsafe(64, unsigned(X(Regidx(trunc(rs1))))), 64))
    },
  }
}

