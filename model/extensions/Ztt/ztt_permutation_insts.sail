  (AME_MROWUNZIP_EW, ms1, ms2) <-> perm_r3pairfunct7_ms_ms_mnemonic(AME_MROWUNZIP_EW) ^ spc() ^ amereg_name_raw(ms1) ^ sep() ^ amereg_name_raw(ms2),
  (AME_MROWZIP_EW, ms1, ms2) <-> perm_r3pairfunct7_ms_ms_mnemonic(AME_MROWZIP_EW) ^ spc() ^ amereg_name_raw(ms1) ^ sep() ^ amereg_name_raw(ms2),
}

union clause instruction = PERM_R3PAIR_MS_MS_TYPE : (perm_r3pairfunct7_ms_ms, bits(5), bits(5))

mapping clause encdec = PERM_R3PAIR_MS_MS_TYPE(op, ms1, ms2)
  <-> encdec_perm_r3pairfunct7_ms_ms(op) @ ms2 : bits(5) @ ms1 : bits(5) @ 0b000 @ 0b00000 @ 0b0101011
  when currentlyEnabled(Ext_Ztt)

mapping clause assembly = PERM_R3PAIR_MS_MS_TYPE(op, ms1, ms2)
  <-> perm_r3pairfunct7_ms_ms_assembly(op, ms1, ms2)

function clause execute PERM_R3PAIR_MS_MS_TYPE(op, ms1, ms2) = {
  if not(ame_context_owned()) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(ms1)) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(ms2)) then return Illegal_Instruction();
  if ms1 == ms2 then return Illegal_Instruction();
  match op {
    AME_MCOLUNZIP_EW => ame_retire_if(ame_pair_permute_ew(MD(Mdregidx(ms1)), MD(Mdregidx(ms2)), Ameregidx(ms1), Ameregidx(ms2), AME_PAIR_COL_UNZIP)),
    AME_MCOLZIP_EW => ame_retire_if(ame_pair_permute_ew(MD(Mdregidx(ms1)), MD(Mdregidx(ms2)), Ameregidx(ms1), Ameregidx(ms2), AME_PAIR_COL_ZIP)),
    AME_MROWUNZIP_EW => ame_retire_if(ame_pair_permute_ew(MD(Mdregidx(ms1)), MD(Mdregidx(ms2)), Ameregidx(ms1), Ameregidx(ms2), AME_PAIR_ROW_UNZIP)),
    AME_MROWZIP_EW => ame_retire_if(ame_pair_permute_ew(MD(Mdregidx(ms1)), MD(Mdregidx(ms2)), Ameregidx(ms1), Ameregidx(ms2), AME_PAIR_ROW_ZIP)),
  }
}

