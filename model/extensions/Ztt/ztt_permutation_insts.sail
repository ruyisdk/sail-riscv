function clause execute PERM_R3_XD_MS_XS_TYPE(op, rd, rs1, rs2) = {
  if not(ame_context_owned()) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(rs1)) then return Illegal_Instruction();
  match op {
    AME_MMOVE8_X_M => {
      match ame_debug_mmove_read(Ameregidx(rs1), X(Regidx(trunc(rs2))), 8) {
        Some(value) => { X(Regidx(trunc(rd))) = zero_extend(value[7..0]); RETIRE_SUCCESS },
        None() => Illegal_Instruction(),
      }
    },
    AME_MMOVE16_X_M => {
      match ame_debug_mmove_read(Ameregidx(rs1), X(Regidx(trunc(rs2))), 16) {
        Some(value) => { X(Regidx(trunc(rd))) = zero_extend(value[15..0]); RETIRE_SUCCESS },
        None() => Illegal_Instruction(),
      }
    },
    AME_MMOVE32_X_M => {
      match ame_debug_mmove_read(Ameregidx(rs1), X(Regidx(trunc(rs2))), 32) {
        Some(value) => { X(Regidx(trunc(rd))) = zero_extend(value[31..0]); RETIRE_SUCCESS },
        None() => Illegal_Instruction(),
      }
    },
    AME_MMOVE64_X_M => {
      if xlen < 64 then return Illegal_Instruction();
      match ame_debug_mmove_read(Ameregidx(rs1), X(Regidx(trunc(rs2))), 64) {
        Some(value) => { X(Regidx(trunc(rd))) = to_bits_unsafe(xlen, unsigned(value)); RETIRE_SUCCESS },
        None() => Illegal_Instruction(),
      }
    },
  }
}

// *****************************************************************
// mconv.ew
union clause instruction = AME_MCONV_EW : (bits(5), bits(5))

mapping clause encdec = AME_MCONV_EW(rd, rs1)
  <-> 0b101000101101 @ rs1 : bits(5) @ 0b000 @ rd : bits(5) @ 0b0101011
  when currentlyEnabled(Ext_Ztt)

mapping clause assembly = AME_MCONV_EW(rd, rs1)
  <-> "mconv.ew" ^ spc() ^ amereg_name_raw(rd) ^ sep() ^ amereg_name_raw(rs1)

function clause execute AME_MCONV_EW(rd, rs1) = {
  if not(ame_context_owned()) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(rd)) then return Illegal_Instruction();
  if not(ame_check_mreg_operand(rs1)) then return Illegal_Instruction();
  ame_retire_if(ame_mconv_ew(MD(Mdregidx(rd)), MD(Mdregidx(rs1)), Ameregidx(rd), Ameregidx(rs1)))
}
